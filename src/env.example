# Environment configuration for Cotswolds Vacation
NEXT_PUBLIC_SITE_NAME="Cotswolds Luxury Retreat"
NEXT_PUBLIC_SITE_URL="https://www.cotswoldsvacation.com"
NEXT_PUBLIC_CURRENT_WEBSITE="cotswolds"

# Contact form email (optional — falls back to privacy@cotswoldsvacation.com)
CONTACT_EMAIL=privacy@cotswoldsvacation.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Port configuration
PORT=3001

# Image optimization
NEXT_PUBLIC_IMAGE_OPTIMIZATION_LEVEL="high"
